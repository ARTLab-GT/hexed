#ifndef HEXED_CONFIG_HPP_
#define HEXED_CONFIG_HPP_

#include <string>
#include <cstdint>

/*! \file hexed_config.hpp.in
 * \brief Supplies options configured by `build.py` to C++ code.
 * \details Anything wrapped in `{[]}`s will be evaluated as Python code and substituted at build time.
 */

//! \brief Namespace for options configured at build time. See \ref hexed_config.hpp.in.
namespace hexed::config {

constexpr int version_major = {[options["version_major"]]}; //!< \brief this is Hexed version \ref version_major .\ref version_minor .\ref version_patch
constexpr int version_minor = {[options["version_minor"]]}; //!< \brief this is Hexed version \ref version_major .\ref version_minor .\ref version_patch
constexpr int version_patch = {[options["version_patch"]]}; //!< \brief this is Hexed version \ref version_major .\ref version_minor .\ref version_patch
//! \brief commit hash of the source this code was compiled from
//! \note hex digits stored as a c-string since there isn't a standard integer type large enough to hold it as an integer
extern const std::string commit;
constexpr int max_row_size = {[options["max_row_size"]]}; //!< \brief maximum \ref basis_row_size "row size" that a `Basis` is allowed to have
#define HEXED_THREADED {[int(options["threaded"])]}
#if HEXED_THREADED
constexpr int n_threads = {[options["n_threads"]]}; //!< \brief number of threads with which to execute parallel regions
#endif
#define HEXED_USE_XDMF {[int(options["use_xdmf"])]}
#define HEXED_USE_TECPLOT {[int(options["use_tecio"])]}
#define HEXED_USE_NLOPT 0
#define HEXED_USE_OCCT {[int(options["use_occt"])]}
#define HEXED_OBSESSIVE_TIMING {[int(options["obsessive_timing"])]}
#define HEXED_VIS_MESH_OPT 0

}
#endif
