PROJECT_NAME = hexed
PROJECT_NUMBER = {[options["version"]]}
INPUT = {[options["source_dir"]]}include {[options["source_dir"]]}libhexed {[options["source_dir"]]} {[options["build_dir"]]}python_package/hexedpy {[options["build_dir"]]}doc
OUTPUT_DIRECTORY = {[options["build_dir"]]}doc
GENERATE_TREEVIEW = YES
DISABLE_INDEX = YES
USE_MATHJAX = YES
FILE_PATTERNS += *.in *.py
EXTENSION_MAPPING += in=c++
WARN_IF_UNDOCUMENTED = NO
MACRO_EXPANSION = YES
GENERATE_LATEX = NO
GENERATE_TAGFILE = hexed.tag
PREDEFINED = HEXED_USE_NLOPT=1 HEXED_USE_OTTER=1 HEXED_USE_TECPLOT=1 HEXED_USE_XDMF=1 HEXED_THREADED=1 HEXED_USE_OCCT=1
VERBATIM_HEADERS = NO
EXAMPLE_PATH = {[options["source_dir"]]}
HTML_EXTRA_STYLESHEET = {[options["source_dir"]]}/doc/style.css
ALIASES += today="{[options["date"]]}" proj_version=" version {[options["version"]]}, commit `{[options["commit"]]}`" me="\ref Contact \"me\"" show_details="\details \f$ \f$"
IMAGE_PATH = {[options["build_dir"]]}doc/html/
CITE_BIB_FILES = {[options["source_dir"]]}/doc/references.bib
COLLABORATION_GRAPH = NO
