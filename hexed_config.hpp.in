#ifndef HEXED_CONFIG_HPP_
#define HEXED_CONFIG_HPP_

#include <string>

/*! \file hexed_config.hpp.in
 * \brief Supplies options configured by `build.py` to C++ code.
 * \details Anything wrapped in `{[]}`s will be evaluated as Python code and substituted at build time.
 * If you want to include this file, instead include `config.hpp` which will redirect to this file
 * in a way that works for use in both Hexed itself and code that uses the `hexed` library.
 */

//! \brief Namespace for options configured at build time. See \ref hexed_config.hpp.in.
namespace hexed::config
{

constexpr int version_major = {[version_major]}; //!< \brief this is Hexed version \ref version_major .\ref version_minor .\ref version_patch
constexpr int version_minor = {[version_minor]}; //!< \brief this is Hexed version \ref version_major .\ref version_minor .\ref version_patch
constexpr int version_patch = {[version_patch]}; //!< \brief this is Hexed version \ref version_major .\ref version_minor .\ref version_patch
//! \brief commit hash of the source this code was compiled from
//! \note hex digits stored as a c-string since there isn't a standard integer type large enough to hold it as an integer
extern const std::string commit;
constexpr int max_row_size = {[option("max-row-size")]}; //!< \brief maximum \ref basis_row_size "row size" that a `Basis` is allowed to have
#define HEXED_THREADED {[int(option("threaded"))]}
#if HEXED_THREADED
constexpr int n_threads = {[option("n-threads")]}; //!< \brief number of threads with which to execute parallel regions
#endif
#define HEXED_USE_XDMF {[int(option("use-xdmf"))]}
#define HEXED_USE_TECPLOT {[int(option("use-tecplot"))]}
#define HEXED_USE_NLOPT 0
#define HEXED_USE_OCCT {[int(option("use-occt"))]}
#define HEXED_OBSESSIVE_TIMING {[int(option("obsessive-timing"))]}

}
#endif
