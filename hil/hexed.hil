{utilities}
version = version_major + {.} + version_minor + {.} + version_patch
license = newline + read {LICENSE.txt}
heat_rat = 1.4
momentum_expr = {momentum0 = momentum0; momentum1 = momentum1; momentum2 = momentum2;}
density_expr = {density = density;}
energy_expr = {energy = energy;}
residual_momentum_expr = {residual_momentum0 = (momentum0 - prev_momentum0)/tss; residual_momentum1 = (momentum1 - prev_momentum1)/tss; residual_momentum2 = (momentum2 - prev_momentum2)/tss;}
residual_density_expr = {residual_density = (density - prev_density)/tss;}
residual_energy_expr = {residual_energy = (energy - prev_energy)/tss;}
residual_expr = residual_momentum_expr + residual_density_expr + residual_energy_expr
field_residual_expr = {
    residual_momentum0 = residual_momentum0
    residual_momentum1 = residual_momentum1
    residual_momentum2 = residual_momentum2
    residual_density = residual_density
    residual_energy = residual_energy
}
velocity_expr = {velocity0 = momentum0/density; velocity1 = momentum1/density; velocity2 = momentum2/density;}
speed_expr = {speed = sqrt(velocity0^2 + velocity1^2 + velocity2^2);}
pressure_expr = {pressure = (heat_rat - 1)*(energy - 0.5*density*speed^2);}
temperature_expr = {temperature = pressure/(density*specific_gas_air);}
mach_expr = {mach = speed/sqrt(heat_rat*pressure/density);}
art_visc_expr = {bulk_art_visc = bulk_art_visc; laplacian_art_visc = laplacian_art_visc;}
visc_stress_expr = {visc_stress0 = visc_stress0; visc_stress1 = visc_stress1; visc_stress2 = visc_stress2;}
stress_expr = {stress0 = -pressure*normal0 + visc_stress0; stress1 = -pressure*normal1 + visc_stress1; stress2 = -pressure*normal2 + visc_stress2;}
heat_flux_expr = {heat_flux = heat_flux;}
iteration_expr = {iteration = iteration; time_stage = time_stage; pseudotime_iteration = pseudotime_iteration;}
art_visc_residual_expr = {art_visc_residual = art_visc_residual;}
normalized_residual_expr = {normalized_residual = (residual_momentum/init_residual_momentum + residual_density/init_residual_density + residual_energy/init_residual_energy)/3;}
flow_time_expr = {flow_time = flow_time;}
time_step_expr = {time_step = time_step;}
fix_iters_expr = {fix_iters = fix_iters;}
skin_friction_coef_expr = {skin_friction_coef = (visc_stress0^2 + visc_stress1^2 + visc_stress2^2)^.5/(.5*freestream_density*freestream_speed^2);}
pressure_coef_expr = {pressure_coef = (pressure - freestream_pressure)/(.5*freestream_density*freestream_speed^2);}
state_vars = momentum_expr + density_expr + energy_expr + velocity_expr + speed_expr + pressure_expr + temperature_expr + mach_expr
compute_force = {
    integrand_surface = velocity_expr + speed_expr + pressure_expr + stress_expr
    integrate_surface
    force0 = integral_surface_stress0
    force1 = integral_surface_stress1
    force2 = integral_surface_stress2
    drag = force0*freestream_direction0 + force1*freestream_direction1 + force2*freestream_direction2
    lift = 0.
    side_force = 0.
    case1 = {}
    case2 = {lift = force1*freestream_direction0 - force0*freestream_direction1}
    case3 = {
        horiz_norm = (freestream_direction0^2 + freestream_direction1^2)^.5
        lift = force2*horiz_norm - (force0*freestream_direction0 + force1*freestream_direction1)/horiz_norm*freestream_direction2
        side_force = (force1*freestream_direction0 - force0*freestream_direction1)/horiz_norm
    }
    $$({case} + n_dim)
    drag_coef = drag/(0.5*freestream_density*freestream_speed^2)
    lift_coef = lift/(0.5*freestream_density*freestream_speed^2)
    side_force_coef = side_force/(0.5*freestream_density*freestream_speed^2)
}
print_force = {
    $compute_force
    println({drag: } + drag + { N})
    println({lift: } + lift + { N})
    println({side force: } + side_force + { N})
    println({drag coefficient: } + drag_coef)
    println({lift coefficient: } + lift_coef)
    println({side force coefficient: } + side_force_coef)
}
force_coef_expr = {lift_coef = lift_coef; drag_coef = drag_coef;}
compute_heating = {
    integrand_surface = heat_flux_expr
    integrate_surface
    heating_rate = integral_surface_heat_flux
}
heating_rate_expr = {heating_rate = heating_rate;}
freestream_spec_int_ener = {(freestream3/freestream2 - 0.5*(freestream0^2 + freestream1^2)/freestream2^2)}
freestream_sound_speed_expr = {((heat_rat*(heat_rat - 1)*$freestream_spec_int_ener)^0.5)}
vortex_nondim_veloc = 0.3
vortex_argmax_radius = 0.1
vortex_gaussian = {(vortex_nondim_veloc*exp((1. - ((pos0 - freestream0/freestream2*flow_time)^2 + (pos1 - freestream1/freestream2*flow_time)^2)/vortex_argmax_radius^2)/2.))}
vortex_scalar = {(1 - (heat_rat - 1.)/2*$vortex_gaussian^2)}
vortex_momentum0 = {((freestream0/freestream2 - pos1/vortex_argmax_radius*$vortex_gaussian*$freestream_sound_speed_expr)*$vortex_mass)}
vortex_momentum1 = {((freestream1/freestream2 + pos0/vortex_argmax_radius*$vortex_gaussian*$freestream_sound_speed_expr)*$vortex_mass)}
vortex_mass = {(freestream2*$vortex_scalar^(1./(heat_rat - 1.)))}
vortex_energy = {($freestream_spec_int_ener*$vortex_scalar*$vortex_mass + 0.5*($vortex_momentum0^2 + $vortex_momentum1^2)/$vortex_mass)}
vortex = {
    momentum0 = $vortex_momentum0
    momentum1 = $vortex_momentum1
    density = $vortex_mass
    energy = $vortex_energy
}
air_visc_ref = 1.716e-5
air_visc_ref_temp = 273.
air_visc_offset = 111.
air_cond_ref = .0241
air_cond_ref_temp = 273.
air_cond_offset = 194.
air_viscosity = {ref_value = air_visc_ref; ref_temperature = air_visc_ref_temp; offset = air_visc_offset}
air_conductivity = {ref_value = air_cond_ref; ref_temperature = air_cond_ref_temp; offset = air_cond_offset}

shock_sub_iters = 12; {number of sub-iterations to run in each nominal iteration to get efficient Chebyshev-accelerated diffusion}
set_shock = {
    art_visc_width = (mesh_extreme01 - mesh_extreme00)*2.^-init_ref_level
    fix_therm_admis = true
    n_cheby_av = shock_sub_iters
    flow_iters = shock_sub_iters
    av_advect_iters = ceil(shock_sub_iters/5.)
    print_vars = print_vars + art_visc_residual_expr
}

ramping_initial_safety = 3e-3
ramping_final_safety = 0.7
ramp_if = {iteration >= 1000}
ramped = false
ramp_action = {
    ramped = true;
    max_safety = ramping_final_safety
    print_emph = true; print{Initial phase complete.}
    print({ Increasing safety factor to } + max_safety + {.})
}
set_ramping = {
    max_safety = ramping_initial_safety
    iterate = iterate + {
        case0 = {}
        case1 = {$ramp_action; println{}}
        $$({case} + (!ramped & ($ramp_if) != 0))
    }
}

bl_multirate_iters = 10
set_subsonic_bl_multirate = {
    bl_multirate = true
    flow_iters = bl_multirate_iters
    bl_iters = bl_multirate_iters
}

aerothermo_bl_multirate = true
aerothermo_conv_sub_iters = 2
set_aerothermo = {
    $set_shock
    $set_ramping
    viscosity_model = air_viscosity
    conductivity_model = air_conductivity
    print_vars = print_vars + heating_rate_expr
    iterate = {$compute_heating} + iterate
    case0 = {}
    case1 = {
        ramp_action = ramp_action + {
            print{ Activating boundary layer acceleration scheme.}
            bl_multirate = true
            n_cheby_bl = 2
            max_conv_sub_iters = aerothermo_conv_sub_iters
            iterate = iterate + {
                case0 = {}
                case1 = {
                    n_cheby_bl = n_cheby_bl + 2
                }
                $$({case} + (n_cheby_bl < bl_multirate_iters))
            }
        }
    }
    $$({case} + aerothermo_bl_multirate)
}

plot_history = {shell({python3 -c "from hexedpy.utils import History_plot;History_plot('} + working_dir + {')" &})}

{scalar parameters}
row_size = 6
init_ref_level = 3
steady = true
implicit = true
implicit_scheme = {backward Euler}
amr = false
max_ref_level = 1000
geom_rtol = 1e-5
geom_atol = 0.
adapt_threshold = 1e-4
wall_spacing = huge
viscosity_model = {}
conductivity_model = {}
turbulence_model = {}
turbulent_prandtl = .9
thermal_bc = {heat_flux = 0.}
surface_bc = {auto}
temperature_offset = 0.
attack = 0.
sideslip = 0.
art_visc_constant = -1.
art_visc_width = -1.
fix_therm_admis = false
diffusive_admissibility = false
working_dir = {hexed_out/}
input_data = {auto}
vis_freq = 10^4
write_freq = 10^4
iter_width = 10
print_freq = 100
update_roughness_freq = 10^3
adapt_start_residual = 1e-2
adapt_residual_factor = .5
surface_roughness = -1.
max_roughness_plus = 4.
init_refine_if = {ref_level < init_ref_level;}
init_unrefine_if = {false}
geom_refine_if = {(uncertainty > geom_rtol*geom_length + geom_atol & ref_level < max_ref_level & nom_sz > min_elem_size)}
geom_unrefine_if = {false}
final_refine_if = {(has_wall & i_dim == wall_dimension & $({nominal_shape} + has_wall*wall_dimension) > wall_spacing)}
final_unrefine_if = {false}
adapt_refine_if = {(discontinuity > adapt_threshold)}
adapt_unrefine_if = {(discontinuity < adapt_threshold/2^row_size & $({aniso_ref_level} + i_dim) > init_ref_level)}
adapt_if = {(normalized_residual < adapt_residual_factor*adapt_last_residual)}
max_init_refine_iters = 100
max_geom_refine_iters = 100
max_final_refine_iters = 100
n_smooth = 30
vis_surface = true
vis_field = true
vis_contour = true
vis_xdmf = false
vis_tecplot = false
vis_csv = false
$({vis_} + vis_default_format) = true
vis_skew = false
vis_lts_constraints = false
vis_edges = true
vis_geom = true
vis_geom_distance = false
vis_field_vars = state_vars + art_visc_expr
vis_contour_vars = vis_field_vars
vis_surface_vars = state_vars + visc_stress_expr + heat_flux_expr + pressure_coef_expr + skin_friction_coef_expr
vis_n_sample = 10
print_vars = iteration_expr + normalized_residual_expr + flow_time_expr + time_step_expr
monitor_window = 0.25
monitor_samples = 100
monitor_vars = {}
integrand_field = {}
integrand_surface = {}
mesh_extreme_eps = 1e-6
layer_split_points = {split0 = 1./3.;}
init_layer_splits = 0
heat_flux_coercion = 2.
min_elem_size = 0.
elementwise_art_visc_pde = false
prefer_occt = false
min_geom_subdiv_levels = 8
max_geom_subdiv_levels = 15
geom_vis_subdivisions = 100
coincidence_tol_bbox = 1e-6
coincidence_tol_abs = 0.
coincidence_tol_subdiv = 1.
tangency_tol_angle = 1*degree
tangency_tol_subdiv = 10.

{array parameters}
i_dim = 0
while = {i_dim < 3}
do = {
    mesh_code = {
        mesh_index = {} + i_dim + sign
        $({mesh_extreme} + mesh_index) = 0. + sign
        $({extremal_bc} + mesh_index) = {characteristic}
        $({geom_vis_bound} + mesh_index) = 0. + sign
    }
    sign = 0; $mesh_code
    sign = 1; $mesh_code
    $({flood_fill_start} + i_dim) = huge
    i_dim = i_dim + 1
}
$loop

init_cond =  {
    momentum0 = freestream_density*freestream_velocity0 + 0*pos0
    momentum1 = freestream_density*freestream_velocity1 + 0*pos0
    momentum2 = freestream_density*freestream_velocity2 + 0*pos0
    density = freestream_density + 0*pos0
    energy = freestream_energy + 0*pos0
    case0 = {}
    case1 = {
        turbulent_kinetic_energy = freestream_density*freestream_specific_turbulent_kinetic_energy
        turbulent_dissipation_bassi = freestream_density*log(freestream_specific_turbulent_dissipation)
    }
    $$({case} + (turbulence_model == {k-omega}))
}
wall_velocity = {
    velocity0 = 0.
    velocity1 = 0.
    velocity2 = 0.
}

{overrideable macros}
write_init = {write_mesh}
write_final = {write_mesh; write_state; write_status}
vis_init = {visualize}
vis_final = {visualize}
print_init = {println header}
print_final = {
    case0 = {println{simulation complete}}
    case1 = {print_type = {error}; println{simulation failed}}
    print_emph = true; $$({case} + hexed_failed)
    println({wall clock time = } + wall_time + {s = } + wall_time/minute + {min = } + wall_time/hour + {hr})
    println {}
    println {performance summary:}
    println performance_report
}
done = {print_emph = true; print_type = {error}; println {Error: you forgot to set `done`} & throw}
time_step_done = {print_emph = true; print_type = {error}; println {Error: you forgot to set `time_step_done`} & throw}
hexed_failed = false
terminate = {
    print_emph = true
    print_type = {error}
    println {User commanded termination.}
    hexed_failed = true
}

write_iter = {
    case0 = {}
    case1 = {
        write_mesh
        write_state
        write_status
    }
    $$({case} + (iteration%write_freq == 0))
}

vis_iter = {
    case0 = {}
    case1 = {visualize}
    $$({case} + (iteration%vis_freq == 0))
}

adapt_iter = {
    case0 = {}
    case1 = {
        adapt
        adapt_last_residual = normalized_residual
    }
    $$({case} + (amr & ($adapt_if)))
}

setup_io = {
    case0 = {}
    case1 = {working_dir = working_dir + {/}}
    $$({case} + (working_dir#(#working_dir - 1) != {/}))
    shell({if [ ! -d } + working_dir + { ]; then mkdir } + working_dir + {; fi})
    setup_output
    case1 = {shell({cp } + input_script + { } + working_dir)}
    $$({case} + (#input_script != 0))
    case1 = {input_data = working_dir + {latest}}
    $$({case} + (input_data == {auto}))
}

restart = {
    print {reading restart data...}
    $setup_io
    $read(input_data + {.status.hil})
    create_solver
    read_mesh
    mesh_init = true
    read_state
    read_status
    println {done}
}

iterate = {
    prev_residual = normalized_residual
    update
    compute_residuals
    {compute initial residual for normalization}
    case0 = {}
    case1 = {
        init_residual_momentum = residual_momentum
        init_residual_density = residual_density
        init_residual_energy = residual_energy
        residual_init = true
    }
    $$({case} + !residual_init)
    println report
    hexed_prev_except = except
    except = {println exception}
    $(read(working_dir + {runtime_cmd.hil}))
    except = hexed_prev_except
    shell({echo > } + working_dir + {runtime_cmd.hil})
    hexed_done = (($done) != 0) | hexed_failed
    case0 = {}
    case1 = {
        hexed_time_step_done = ($time_step_done) != 0
        hexed_done = hexed_done & hexed_time_step_done & time_stage == n_time_stages - 1
    }
    $$({case} + (!steady & implicit))
    case0 = {}
    case1 = {
        case0 = {}
        case1 = {
            $adapt_iter
            $write_iter
            $vis_iter
            case0 = {}
            case1 = {
                update_roughness
                println({updating surface roughness to } + surface_roughness)
            }
            $$({case} + (update_roughness_freq > 0 & iteration%update_roughness_freq == 0 & turbulence_model == {k-omega}))
        }
        $$({case} + (time_stage == n_time_stages - 1))
        case0 = {}
        case1 = {next_time_stage}
        $$({case} + (!steady & implicit))
    }
    $$({case} + (hexed_time_step_done & !hexed_done))
}

start = {
    $setup_io
    case1 = {
        case1 = {surface_bc = {nonpenetration}}
        case0 = {surface_bc = {no_slip}}
        $$({case} + (viscosity_model == {}))
    }
    $$({case} + (surface_bc == {auto}))
    case0 = {}
    case1 = {
        i_dim = 0
        while = {i_dim < n_dim}
        do = {
            $({flood_fill_start} + i_dim) = (1 - mesh_extreme_eps)*$({mesh_extreme} + i_dim + 0) + mesh_extreme_eps*$({mesh_extreme} + i_dim + 1)
            i_dim = i_dim + 1
        }
        $loop
    }
    $$({case} + (flood_fill_start0 == huge))
    setup_parameters
    create_solver
    residual_init = false
    init_residual_momentum = 0.
    init_residual_density = 0.
    init_residual_energy = 0.
    normalized_residual = 1.
    adapt_last_residual = adapt_start_residual
    prev_residual = 0.
    hexed_next_flow_time = 0.
}

mesh_init = false

run = {
    $write_init
    $vis_init
    $print_init
    shell({echo > } + working_dir + {runtime_cmd.hil})
    hexed_time_step_done = true
    hexed_done = false
    while = {!hexed_done}
    do = {$iterate}
    $loop
    $print_final
    $write_final
    $vis_final
}

simulate = {
    $start
    mesh
    init_state
    $run
}
