[build-system]
requires = ["setuptools"]
build-backend = "setuptools.build_meta"

[project]
name = "hexedpy"
version = "{[version]}"
authors = [
  { name="Micaiah Smith-Pierce", email="micaiah@gatech.edu" },
]
description = "Python utilities for use with the Hexed CFD solver"
readme = "README.md"
requires-python = ">=3.8"
classifiers = [
    "Programming Language :: Python :: 3",
    "License :: OSI Approved :: MIT License",
    "Operating System :: OS Independent",
]
dependencies = [
    "numpy",
    "matplotlib",
    "pandas",
    "sympy",
    "scipy",
    "gitpython",
]

[project.urls]
Homepage = "https://github.com/ARTLab-GT/hexed"
Documentation = "https://artlab-gt.github.io/hexed/"

[project.scripts]
hil = "hexedpy.wrappers:hil"
hexecute = "hexedpy.wrappers:hexecute"

[tool.setuptools.package-data]
hexedpy = ["bin/*", "lib/*"]
