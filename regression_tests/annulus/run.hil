n_dim = 2
suffix = {}
$read {resolution.hil}
mesh_extreme00 = -1.
mesh_extreme10 = -1.
mesh_extreme01 =  1.
mesh_extreme11 =  1.
geom0 = {auto0.csv}
geom1 = {auto1.csv}
flood_fill_start0 = 0.75
flood_fill_start1 = 0.
flood_fill_start2 = 0.
refine_if = {is_extruded}
unrefine_if = {false}
max_refinement_iters = 1

freestream_temperature = 300.;
freestream_density = 1.;
freestream_speed = 0.;
visc = 1e2
viscosity_model = {const_value = visc}
conductivity_model = {const_value = 1.4*specific_gas_air/0.4*visc}
surface_bc = {expression}
angular_speed = 1e2
outer_radius = 1.
inner_radius = .25
surface_bc_state = {
    ghost_state0 = -pos1*state2*angular_speed*(sqrt(pos0^2 + pos1^2) - inner_radius)/(outer_radius - inner_radius)
    ghost_state1 =  pos0*state2*angular_speed*(sqrt(pos0^2 + pos1^2) - inner_radius)/(outer_radius - inner_radius)
    ghost_state2 = state2
    ghost_state3 = state2*specific_gas_air*freestream_temperature/0.4 + .5*(state0^2 + state1^2)/state2;
}
surface_bc_flux = {
    ghost_flux0 = flux0
    ghost_flux1 = flux1
    ghost_flux2 = 0.
    ghost_flux3 = flux3
}
l2_error = 0.

error_expr = {
    radius = sqrt(pos0^2 + pos1^2)
    speed = angular_speed*(inner_radius/radius - radius/inner_radius)/(inner_radius/outer_radius - outer_radius/inner_radius)
    pointwise_error = (momentum0/density - -pos1/radius*speed)^2 + (momentum1/density -  pos0/radius*speed)^2
}

fix_therm_admis = true
n_cheby_flow = 10
shell {python3 make_geom.py}
print_vars = print_vars + {l2_error = l2_error;}
vis_field_vars = vis_field_vars + error_expr
iterate = {
    integrand_field = error_expr
    integrate_field
    l2_error = sqrt(integral_field_pointwise_error/pi/(outer_radius^2 - inner_radius^2))/angular_speed/outer_radius
} + iterate
monitor_vars = {l2_error = l2_error;}
working_dir = {hexed_out} + suffix + row_size + {_} + init_ref_level
done = {iteration > 1000 & l2_error_max - l2_error_min < 1e-2*(l2_error_min + l2_error_max)/2}
$plot_history
$simulate
shell({echo "} + row_size + { } + init_ref_level + { } + wall_time + { } + l2_error + {" >> results.txt})
