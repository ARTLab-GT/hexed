n_dim = 3
reference_length = .0635
reference_area = pi*reference_length^2
domain_size = 2*reference_length
domain_center0 = -reference_length
domain_center1 =  reference_length
domain_center2 =  reference_length
flood_fill_start0 = -1.7*reference_length
flood_fill_start1 =  1.7*reference_length
flood_fill_start2 =  1.7*reference_length
extremal_bc20 = {nonpenetration}
extremal_bc10 = {nonpenetration}
extremal_bc01 = {pressure_outflow}
geom0 = {quarter.iges}
max_sharp_reynolds = huge
max_geom_refine_iters = 0

freestream_temperature = 136.1*rankine
viscosity_model = air_viscosity
conductivity_model = air_const_prandtl_conductivity
freestream_mach = 5.
reynolds = 1.8875e6
wall_temperature = 1.308*freestream_temperature
thermal_bc = {temperature = wall_temperature}

capture_shocks = true
print_freq = 10
vis_freq = write_freq = 1000
monitor_vars = {heating_rate = heating_rate;}
contour0 = {pos0 + 1e-8}
contour1 = {pos1 - pos2}
contour2 = {wall_distance - 1e-4}
vis_field = false

$plot_history
$simulate
vis_field = true
visualize
