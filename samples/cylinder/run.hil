shell {python3 make_geom.py}

{mesh setup}
n_dim = 2
mesh_extreme00 = -4.*.02
mesh_extreme01 =  0.*.02
mesh_extreme10 =  0.*.02
mesh_extreme11 =  4.*.02
extremal_bc10 = {nonpenetration}
extremal_bc01 = {pressure_outflow}
geom0 = {auto.csv}
amr = true;

{freestream/wall definition}
freestream_mach = 8.1
freestream_pressure = 370.6
freestream_temperature = 63.73
{
thermal_bc = {temperature = 300}

{iteration parameters}
$set_aerothermo
ramping_final_safety = .8
art_visc_width = art_visc_width*.7/8
viscosity_model = air_viscosity
conductivity_model = {ref_value = 1.4/0.4*specific_gas_air/.72*air_visc_ref; ref_temperature = air_visc_ref_temp; offset = air_visc_offset}
monitor_vars = {heating_rate = heating_rate;}
done = {iteration > 10^4 & heating_rate_max - heating_rate_min < 10.}
}
{
freestream_mach = 3.
altitude = 0.
}
$set_shock
max_safety = 1e-4
max_residual = 1.
final_safety = .7
ramping_done = false
iterate = iterate + {
    case0 = {}
    case1 = {
        max_safety = max_safety*2
        print_emph = true
        println({Increasing safety factor to } + max_safety)
        emph = false
        case0 = {}
        case1 = {
            max_safety = final_safety
            ramping_done = true
        }
        $$({case} + (max_safety > final_safety))
        max_residual = normalized_residual
    }
    $$({case} + (normalized_residual < .5*max_residual))
    case0 = {}
    case1 = {max_residual = normalized_residual; print_emph = true; println({max_residual is now } + max_residual);}
    $$({case} + (normalized_residual > max_residual & iteration > 1))
}
art_visc_width = .001
diffusive_admissibility = false
vis_field_vars = vis_field_vars + field_residual_expr + {spectral_uncertainty0 = spectral_uncertainty0; spectral_uncertainty1 = spectral_uncertainty1; spectral_uncertainty2 = spectral_uncertainty2;}
vis_freq = write_freq = 1000
adapt_freq = 100

{
$plot_history
}
$simulate
