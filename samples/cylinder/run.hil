shell {python3 make_geom.py}

{mesh setup}
n_dim = 2
mesh_extreme00 = -4.*.02
mesh_extreme01 =  0.*.02
mesh_extreme10 =  0.*.02
mesh_extreme11 =  4.*.02
extremal_bc10 = {nonpenetration}
extremal_bc01 = {pressure_outflow}
geom0 = {auto.csv}
{
amr = true
}
elementwise_art_visc = true

{freestream/wall definition}
freestream_mach = 8.1
freestream_pressure = 370.6
freestream_temperature = 63.73
thermal_bc = {temperature = 300}
{
viscosity_model = air_viscosity
conductivity_model = {ref_value = 1.4/0.4*specific_gas_air/.72*air_visc_ref; ref_temperature = air_visc_ref_temp; offset = air_visc_offset}
monitor_vars = {heating_rate = heating_rate;}
spectral_tol = spectral_tol/10
}

monitor_vars = {lift_coef = lift_coef; drag_coef = drag_coef;}


$set_shock
$set_ramping
ramping_final_safety = 0.1
working_dir = {hexed_out_elwise}
{
diffusive_admissibility = true
}
art_visc_width = .001
vis_field_vars = vis_field_vars + field_residual_expr + {spectral_uncertainty0 = spectral_uncertainty0; spectral_uncertainty1 = spectral_uncertainty1; spectral_uncertainty2 = spectral_uncertainty2;}
vis_freq = write_freq = 1000

{
$plot_history
}
$simulate
