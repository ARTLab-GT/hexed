n_dim = 2
reference_length = 1.
geom0 = {geom.csv}
viscosity_model = air_viscosity
conductivity_model = air_conductivity
min_elem_size = .01

freestream_temperature = zero_celsius
freestream_speed = 60 ;{approx mach 0.2}
freestream_direction0 = 0.8
freestream_direction1 = 0.6
target_thickness = .01
reynolds = (5/target_thickness)^2
monitor_vars = {drag_coef = drag_coef;}

$plot_history
$simulate
vis_csv = true
vis_xdmf = false
vis_field = false
visualize
