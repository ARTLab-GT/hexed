{
Subsonic NACA 0012 Example Problem: Input file in Hexed Interface Language format.
To run this file, use the command `hexecute run.hil` in this directory.
This file specifies the geometry, freestream conditions, and other user-defined input parameters.
Note: strings are enclosed in `{}`, and strings which are not assigned to anything are used as comments.
}

{domain and mesh parameters}
n_dim = 2
mesh_extreme00 = -10.
mesh_extreme10 = -10.
mesh_extreme01 =  10.
mesh_extreme11 =  10.
amr = true

{generate geometry with external script}
shell {python3 make_geom.py}
geom0 = {auto.csv}

{freestream conditions}
altitude = 0.
freestream_mach = 0.3
attack = 4*degree

{iteration parameters}
print_freq = 1000
vis_freq = 20000
done = {iteration > 10000 & lift_coef_max - lift_coef_min < 1e-3*(lift_coef_min + lift_coef_max)/2}
done = {iteration > 10^6}
iterate = compute_force + iterate
monitor_vars = {lift_coef = lift_coef;}
print_vars = print_vars + force_coef_expr
vis_field_vars = vis_field_vars + {discontinuity0 = discontinuity0; discontinuity1 = discontinuity1; discontinuity2 = discontinuity2;}
vis_field_vars = vis_field_vars + {spectral_uncertainty0 = spectral_uncertainty0; spectral_uncertainty1 = spectral_uncertainty1; spectral_uncertainty2 = spectral_uncertainty2;}

{run simulation}
$simulate
$print_force
