{
Subsonic NACA 0012 Example Problem: Input file in Hexed Interface Language format.
To run this file, use the command `hexecute run.hil` in this directory.
This file specifies the geometry, freestream conditions, and other user-defined input parameters.
Note: strings are enclosed in `{}`, and strings which are not assigned to anything are used as comments.
}

{domain and mesh parameters}
n_dim = 2
row_size = 5
mesh_extreme00 = -10.
mesh_extreme10 = -10.
mesh_extreme01 =  10.
mesh_extreme11 =  10.

extremal_bc00 = {freestream}
extremal_bc01 = {pressure_outflow}
extremal_bc10 = {freestream}
extremal_bc11 = {freestream}

init_ref_level = 4
refine_if = {is_extruded & ref_level < 9}
unrefine_if = {!is_extruded}
{$set_geometry_refinement}
init_layer_splits = 8
$set_subsonic_bl_multirate

viscosity_model = air_viscosity
conductivity_model = air_conductivity
turbulence_model = {k-omega}

{generate geometry with external script}
shell {python3 make_geom.py}
geom0 = {auto.csv}

{freestream conditions}
freestream_temperature = zero_celsius
freestream_mach = 0.3
attack = 0*degree
target_reynolds = 6e6
dyn_visc = 1.716e-5
freestream_density = target_reynolds*dyn_visc/sqrt(specific_gas_air * 1.4 * freestream_temperature)/freestream_mach

domain_length = mesh_extreme01 - mesh_extreme00
freestream_specific_turbulent_kinetic_energy = 1e-3*(freestream_mach*340.)^2/(target_reynolds*domain_length/1.)
freestream_specific_turbulent_dissipation = 10*freestream_mach*340./domain_length
println({turbulent viscosity: } + freestream_density*freestream_specific_turbulent_kinetic_energy/freestream_specific_turbulent_dissipation + { Pa s})
println({ratio: } + freestream_density*freestream_specific_turbulent_kinetic_energy/freestream_specific_turbulent_dissipation/dyn_visc)

surface_bc = {no_slip}
diffusive_admissibility = true
fix_therm_admis = true
max_safety = .1
{
ramping_final_safety = 7e-2
ramp_if = {iteration >= 2000}
$set_ramping
}
update_omega_freq = 2000
working_dir = {hexed_out_new_bc2}

{iteration parameters}
print_freq = 100
vis_freq = 10^3
done = {iteration > 5000 & (drag_coef_max - drag_coef_min < 5e-3*(drag_coef_min + drag_coef_max)/2)}
iterate = compute_force + iterate
monitor_vars = {drag_coef = drag_coef; lift_coef = lift_coef;}
print_vars = print_vars + force_coef_expr

vis_field_vars = vis_field_vars + {
    specific_turbulent_kinetic_energy = turbulent_kinetic_energy/density
    turbulent_dissipation_bassi = turbulent_dissipation_bassi
    specific_turbulent_dissipation = exp(turbulent_dissipation_bassi/density)
    debug_var0 = debug_var0
}

{run simulation}
$start
$mesh
init_state
$run
$print_force

integrand_surface = visc_stress_expr
integrate_surface
force0 = integral_surface_visc_stress0
force1 = integral_surface_visc_stress1
force2 = integral_surface_visc_stress2

v_drag = force0*freestream_direction0 + force1*freestream_direction1 + force2*freestream_direction2
v_drag_coeff = v_drag/(0.5*freestream_density*freestream_speed^2)
println({Viscous drag coef: } + v_drag_coeff)
println({Pressure drag coef: } + (drag_coef - v_drag_coeff))
