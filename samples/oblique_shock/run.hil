n_dim = 2
reference_length = 1.
init_ref_level = 5
domain_center0 = 0.5
domain_center1 = 0.5
domain_size = 1.
flood_fill_start0 = 0.5
flood_fill_start1 = 0.5
surface_max_iters = 1
extremal_bc10 = {nonpenetration}
geom0 = {geom.csv}

altitude = 0
freestream_mach = 2.

capture_shocks = true
wall_shock_width = 0.05
shock_width_growth = 0.
print_freq = 10
vis_freq = 1000
done = {normalized_residual < 1e-4}
contour0 = {mach - 1.7}
contour1 = {pos0 + pos1 - 1.}

$simulate
