n_dim = 2
altitude = 0.
freestream_speed = 100.
init_ref_level = 4
init_cond = vortex
mesh_extreme00 = -1.
mesh_extreme10 = -1.
mesh_extreme01 =  1.
mesh_extreme11 =  1.
surface_max_iters = 0
done = {flow_time >= 6e-3}
print_freq = 10
vis_freq = 100
steady = false
implicit = false

$simulate
integrand_field = {errsq = (density - $vortex_mass)^2}
integrate_field
print {L^2 density error: }
println(integral_field_errsq^0.5)
