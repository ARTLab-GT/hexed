n_dim = 2
altitude = 0.
freestream_speed = 100.
init_ref_level = 4
init_cond = vortex
mesh_extreme00 = -1.
mesh_extreme10 = -1.
mesh_extreme01 =  1.
mesh_extreme11 =  1.
done = {flow_time >= 5.999e-3}
time_step_done = {pseudotime_iteration > 400}
time_step = 1e-3/4
implicit_scheme = {backward euler}
implicit_scheme = {crank-nicolson}
implicit_scheme = {dirk2}
print_freq = 10
vis_freq = 100
steady = false
implicit = true

$simulate
integrand_field = {errsq = (density - $vortex_mass)^2}
integrate_field
print {L^2 density error: }
println(integral_field_errsq^0.5)
