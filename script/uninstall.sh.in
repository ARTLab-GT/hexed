# This script is executed by the `uninstall` target.
# It is not intended to be executed manually.
install_prefix=@CMAKE_INSTALL_PREFIX@
if [ -f install_manifest.txt ]
then
    if [ ! -d uninstalled_files ]
    then
        mkdir uninstalled_files
    fi
    echo "Uninistalling hexed. For safety, uninstalled files are not removed but rather placed in \`./uninstalled_files\`."
    not_found=0
    for name in $(cat install_manifest.txt) $install_prefix/lib/hexed $install_prefix/lib/cmake/hexed
    do
        if [ -e $name ]
        then
            echo "uninstalling: \`$name\`"
            mv $name uninstalled_files/
        else
            echo "not found: \`$name\`"
            not_found=1
        fi
    done
    if [ $not_found -eq 1 ]
    then
        echo "Warning: Some files were not found. Something fishy might be going on."
    fi
else
    echo "error: could not find \`install_manifest.txt\`, which should be generated by \`make install\`"
    exit 1
fi
